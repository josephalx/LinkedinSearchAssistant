# Virtualenv
.venv/
venv/
env/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Secrets / local config
.env
.env.*
!.env.example

# Editor / OS
.vscode/
.idea/
.DS_Store

# Generated output
# matches_export.json is rebuilt by export_matches.py; last_job_debug.html and
# debug_search_page.html/png are scraper page dumps. All hold scraped job data
# and/or are regenerated automatically, so none should be committed.
results/matches_export.json
last_job_debug.html
debug_search_page.html
debug_search_page.png

# Benchmark result dumps from comparison_benchmark.py
benchmarks_results/

# Logs
*.log

# Lock files from api.py's run/stop tracking — recreated automatically
*.lock
